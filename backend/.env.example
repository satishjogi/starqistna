# Star Qistna backend — required env vars.
# Copy this file to `.env` on new deployments and fill in the SECRET fields.
# Non-secret values below are safe defaults; secrets MUST be set per environment.

# --- Database ---
MONGO_URL="mongodb://localhost:27017"
DB_NAME="starqistna"

# --- CORS (comma-separated origins; use "*" for dev only) ---
CORS_ORIGINS="https://starqistna.com,https://www.starqistna.com"

# --- Stripe (SECRET — get from https://dashboard.stripe.com/apikeys) ---
STRIPE_API_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=

# --- JWT (SECRET — generate with: python -c "import secrets; print(secrets.token_hex(64))") ---
JWT_SECRET=REPLACE_WITH_128_CHAR_HEX
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168

# --- Email (Resend — get key from https://resend.com/api-keys) ---
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM="Star Qistna <onboarding@resend.dev>"
EMAIL_REPLY_TO="support@starqistna.com"

# --- Public URLs (used in emails, redirects) ---
PUBLIC_APP_URL="https://starqistna.com"

# --- Bootstrap admin (SECRET — first-boot admin password) ---
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_ME_STRONG_PASSWORD

# --- Google OAuth (own — starqistna.com branded) ---
# Client ID is public-safe. Client secret MUST stay secret.
# Get both from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-REPLACE_ME

# --- GoHub / TBS CTS OnlineQR (boarding-pass QR issuance) ---
# Feature flag — when false, every CTS call is a safe dry-run (no network).
GOHUB_ENABLED=false
# SOAP endpoint. Test: http://47.254.200.95/ws_cts_v2_TBS_test/serviceQR.asmx
#             Live: https://eticketing.tbsbts.com.my/ws_cts_v2/serviceQR.asmx
GOHUB_BASE_URL=
# OTA identity + password used for the MD5 request signature (from TBS).
GOHUB_OTA_CODE=
GOHUB_OTA_PASSWORD=
# Operator identity inside TBS (e.g. QISTINA).
GOHUB_OPERATOR_CODE=
# Branded QR image endpoint (gopass logo). Optional — sensible default built in.
# GOHUB_QR_IMAGE_URL=https://gopassqr.nssit.com.my/QrCodeWithLogo

# --- Boarding gate scanners ---
# Shared secret that gate QR readers must send as the X-Boarding-Key header
# on POST /api/boarding/validate. REQUIRED in production — the endpoint
# returns passenger data and booking references are enumerable without it.
BOARDING_API_KEY=

# --- Environment ---
# "production" enables fail-closed behaviour (e.g. Stripe webhook refuses to
# accept events when STRIPE_WEBHOOK_SECRET is unset).
APP_ENV=development

# --- Demo data (DEV ONLY) ---
# When true, startup seeds demo schedules/promos (BOOKABLE inventory with
# hardcoded fares). Never enable in production.
# SEED_DEMO_DATA=false

# --- Optional: opt-in flag to force-resync admin password on next boot ---
# Set to "true" temporarily to recover from a locked-out admin, then remove.
# RESET_ADMIN_ON_BOOT=false
