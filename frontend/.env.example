# Star Qistna frontend — required env vars.
# Copy this file to `.env` on new deployments.

# Backend API base URL (production: your domain; dev: emergent preview URL)
REACT_APP_BACKEND_URL=https://starqistna.com

# Google OAuth Client ID (public-safe; matches backend GOOGLE_CLIENT_ID)
REACT_APP_GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com

# CRA dev-server settings (safe to keep)
WDS_SOCKET_PORT=443
ENABLE_HEALTH_CHECK=false
